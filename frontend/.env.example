# Base de l'API vue par le navigateur. Laisser /api/v1 : Vite (dev) et nginx (Docker)
# relaient /api vers le gateway, ce qui évite toute configuration CORS.
VITE_API_BASE_URL=/api/v1

# Cible du proxy de développement (npm run dev) : l'api-gateway.
VITE_PROXY_TARGET=http://localhost:8080

# true = mode démonstration : données fictives dans le navigateur, aucun backend requis.
# Comptes : candidat@demo.tn, recruteur@demo.tn, admin@demo.tn — mot de passe demo1234.
VITE_USE_MOCKS=false

# Simulation module par module (le reste appelle le backend), ex. VITE_MOCK_MODULES=jobs,applications
# Modules : auth, candidates, companies, jobs, applications, dashboard.
# VITE_USE_MOCKS=true équivaut à les simuler tous.
VITE_MOCK_MODULES=
