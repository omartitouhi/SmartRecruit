SERVER_PORT=8000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_db
DB_USER=smartrecruit
DB_PASSWORD=smartrecruit

# rules : instantané, sans LLM (défaut) | llm : tâches confiées à OpenRouter
AI_ENGINE=rules

# LLM (OpenRouter) — utilisé seulement avec AI_ENGINE=llm ; sans clé -> 503
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=9
MATCHING_TIMEOUT_SECONDS=14
