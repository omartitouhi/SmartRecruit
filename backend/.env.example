# Variables lues par docker-compose.yml (copier en .env, jamais commité).

# Clé OpenRouter du service IA : sans clé, les endpoints IA répondent 503.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Ports publiés sur la machine hôte (changer si déjà occupés).
POSTGRES_HOST_PORT=5432
AI_HOST_PORT=8000

# Limite de requêtes sur les routes d'authentification (10 en production).
RATE_LIMIT_MAX_REQUESTS=10
