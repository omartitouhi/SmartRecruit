# Variables lues par docker-compose.yml (copier en .env, jamais commité).

# Moteur IA : rules (défaut, instantané, sans LLM) ou llm (OpenRouter, plus lent).
AI_ENGINE=rules

# Clé OpenRouter du service IA, utilisée seulement avec AI_ENGINE=llm (sans clé -> 503).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Ports publiés sur la machine hôte (changer si déjà occupés ou réservés par Windows :
# voir `netsh interface ipv4 show excludedportrange protocol=tcp`).
POSTGRES_HOST_PORT=5432
AI_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# Administrateur créé au démarrage par auth-service (développement uniquement).
ADMIN_EMAIL=admin@smartrecruit.local
ADMIN_PASSWORD=Admin-Dev-2026!

# Limite de requêtes sur les routes d'authentification (10 en production).
RATE_LIMIT_MAX_REQUESTS=10
