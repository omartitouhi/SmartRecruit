# {{ ansible_managed }}
# Variables lues par docker-compose.yml (générées par Ansible, rôle smartrecruit).

# Moteur IA : rules (sans LLM) ou llm (OpenRouter).
AI_ENGINE={{ smartrecruit_ai_engine }}
OPENROUTER_API_KEY={{ smartrecruit_openrouter_api_key }}
OPENROUTER_MODEL={{ smartrecruit_openrouter_model }}

# Ports publiés sur la machine hôte.
POSTGRES_HOST_PORT={{ smartrecruit_postgres_host_port }}
AI_HOST_PORT={{ smartrecruit_ai_host_port }}
FRONTEND_HOST_PORT={{ smartrecruit_frontend_host_port }}

# Administrateur créé au démarrage par auth-service.
ADMIN_EMAIL={{ smartrecruit_admin_email }}
ADMIN_PASSWORD={{ smartrecruit_admin_password }}

# Limite de requêtes sur les routes d'authentification.
RATE_LIMIT_MAX_REQUESTS={{ smartrecruit_rate_limit_max_requests }}
